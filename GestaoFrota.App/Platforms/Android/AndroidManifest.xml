<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<!-- Tráfego em texto claro desativado: a API hospedada usa HTTPS.
	     Para testar contra a API local (http://10.0.2.2:5137), adicione temporariamente
	     android:usesCleartextTraffic="true" e remova antes do build de Release. -->
	<application android:allowBackup="true"
	             android:icon="@mipmap/appicon"
	             android:roundIcon="@mipmap/appicon_round"
	             android:supportsRtl="true"></application>

	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />

	<!-- Comprovantes: câmera e galeria (MediaPicker) -->
	<uses-permission android:name="android.permission.CAMERA" />
	<uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
	<uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
	<uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
	<uses-feature android:name="android.hardware.camera" android:required="false" />

	<queries>
		<intent>
			<action android:name="android.media.action.IMAGE_CAPTURE" />
		</intent>
	</queries>
</manifest>
