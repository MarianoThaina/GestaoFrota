<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:GestaoFrota.App.Views"
       x:Class="GestaoFrota.App.AppShell"
       Title="Gestão de Frota"
       FlyoutBehavior="Flyout"
       FlyoutBackgroundColor="#0B1D3A"
       Shell.ForegroundColor="White"
       Shell.TitleColor="White"
       Shell.BackgroundColor="#0B1D3A">

    <!--
        Navegação por menu lateral (Flyout/Drawer): comporta os 6 módulos do
        Administrador e permite esconder, por perfil, tudo o que o Motorista
        não pode usar (ver AppShell.xaml.cs > ConfigurarMenuPorPerfil).
        A restrição de escrita (RBAC) também é sempre validada no backend.
    -->
    <Shell.FlyoutHeader>
        <VerticalStackLayout Padding="20,36,20,16" Spacing="2" BackgroundColor="#0B1D3A">
            <Label x:Name="LblNomeUsuario" Text="Gestão de Frota" TextColor="White" FontSize="18" FontAttributes="Bold" />
            <Label x:Name="LblPerfilUsuario" Text="" TextColor="#9FB3D1" FontSize="13" />
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <FlyoutItem x:Name="MenuInicio" Title="Início">
        <ShellContent ContentTemplate="{DataTemplate views:DashboardPage}" />
    </FlyoutItem>

    <FlyoutItem x:Name="MenuMovimentacoes" Title="Movimentações">
        <ShellContent ContentTemplate="{DataTemplate views:MovimentacoesPage}" />
    </FlyoutItem>

    <FlyoutItem x:Name="MenuDividas" Title="Dívidas e Financiamentos">
        <ShellContent ContentTemplate="{DataTemplate views:DividasPage}" />
    </FlyoutItem>

    <FlyoutItem x:Name="MenuRelatorios" Title="Relatórios">
        <ShellContent ContentTemplate="{DataTemplate views:RelatoriosPage}" />
    </FlyoutItem>

    <FlyoutItem x:Name="MenuCategorias" Title="Categorias">
        <ShellContent ContentTemplate="{DataTemplate views:CategoriasPage}" />
    </FlyoutItem>

    <FlyoutItem x:Name="MenuFormasPagamento" Title="Formas de Pagamento">
        <ShellContent ContentTemplate="{DataTemplate views:FormasPagamentoPage}" />
    </FlyoutItem>

    <FlyoutItem x:Name="MenuUsuarios" Title="Usuários">
        <ShellContent ContentTemplate="{DataTemplate views:UsuariosPage}" />
    </FlyoutItem>

    <MenuItem Text="Sair" Clicked="OnSairClicked" />

</Shell>
