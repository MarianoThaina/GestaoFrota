<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Este arquivo assume um projeto gerado via:
        dotnet new maui -n GestaoFrota.App
      Rode o comando acima primeiro (ele cria as pastas Platforms/, Resources/AppIcon,
      Resources/Splash, MainActivity, Info.plist, etc. automaticamente para
      Android/iOS/MacCatalyst/Windows) e depois substitua/mescle este csproj e as
      pastas Models/Services/ViewModels/Views por cima dos arquivos gerados.
    -->
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>GestaoFrota.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>Gestão de Frota</ApplicationTitle>
    <ApplicationId>com.suaempresa.gestaofrota</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- MVVM -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />

    <!-- Persistência local (offline-first) -->
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
    <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.10" />

    <!-- Serialização -->
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

  <!--
    Projeto SingleProject do MAUI: os .cs (Models/Services/ViewModels/Views)
    e os .xaml (Views/*.xaml, App.xaml, AppShell.xaml) são incluídos
    automaticamente pelo SDK — não é necessário declará-los aqui.
  -->

</Project>
