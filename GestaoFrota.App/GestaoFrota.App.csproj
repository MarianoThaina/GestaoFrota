<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      O alvo Android já acompanha o repositório (Platforms/Android e Resources/),
      então o app roda no emulador sem precisar de "dotnet new maui".
      iOS/MacCatalyst/Windows só compilam em macOS/Windows e exigem as pastas
      Platforms/<plataforma> geradas por "dotnet new maui" (não usadas na entrega).
    -->
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>GestaoFrota.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>Gestão de Frota</ApplicationTitle>
    <ApplicationId>com.gestaofrota.app</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!--
    APK de Release para instalar direto no celular (sem Play Store).
    Gerar: dotnet publish GestaoFrota.App -f net10.0-android -c Release
    Saída:  GestaoFrota.App/bin/Release/net10.0-android/publish/com.gestaofrota.app-Signed.apk

    Assinatura: sem keystore, o SDK assina com a chave de debug, que basta para
    instalar no celular. Para assinar com chave própria, passe os valores na
    linha de comando (nunca versione o .keystore nem a senha):
      -p:GestaoFrotaKeystore=C:\caminho\gestaofrota.keystore
      -p:GestaoFrotaKeyAlias=gestaofrota
      e a variável de ambiente GESTAOFROTA_KEY_PASS com a senha.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(GestaoFrotaKeystore)' != '' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(GestaoFrotaKeystore)</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>$(GestaoFrotaKeyAlias)</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>env:GESTAOFROTA_KEY_PASS</AndroidSigningKeyPass>
    <AndroidSigningStorePass>env:GESTAOFROTA_KEY_PASS</AndroidSigningStorePass>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ícone e splash (SVG simples, trocáveis) -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0B1D3A" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0B1D3A" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <!-- MVVM -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />

    <!-- Persistência local (offline-first) -->
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
    <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.10" />

    <!-- Logging em DEBUG (usado em MauiProgram) -->
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />

    <!-- Serialização -->
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

  <!--
    Projeto SingleProject do MAUI: os .cs (Models/Services/ViewModels/Views)
    e os .xaml (Views/*.xaml, App.xaml, AppShell.xaml) são incluídos
    automaticamente pelo SDK — não é necessário declará-los aqui.
  -->

</Project>
