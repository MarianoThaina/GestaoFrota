<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GestaoFrota.App.ViewModels"
             xmlns:models="clr-namespace:GestaoFrota.App.Models"
             x:Class="GestaoFrota.App.Views.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="Início">

    <RefreshView IsRefreshing="{Binding Carregando}" Command="{Binding AtualizarCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="24" Spacing="14">

                <Label Text="{Binding Usuario.Nome, StringFormat='Bem-vindo(a), {0} 👋'}"
                       FontSize="22"
                       FontAttributes="Bold" />

                <Label Text="{Binding Usuario.Email}" FontSize="14" TextColor="Gray" />

                <Label Text="{Binding Usuario.Perfil, StringFormat='Perfil: {0}'}" FontSize="14" TextColor="Gray" />

                <!-- US11: veículos em viagem (Administrador, Gestor de Frota e Motorista; lê o cache, funciona offline) -->
                <Frame Padding="16" CornerRadius="16" BorderColor="#DCE3EE" HasShadow="False" IsVisible="{Binding MostrarFrota}">
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Veículos em viagem" FontSize="12" TextColor="Gray" />
                            <Label Text="{Binding VeiculosEmViagemTexto}" FontSize="26" FontAttributes="Bold" TextColor="#0B1D3A" />
                            <Label Text="{Binding VeiculosDetalheTexto}" FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="🚚" FontSize="32" VerticalOptions="Center" />
                    </Grid>
                </Frame>

                <!-- Painel financeiro: somente Administrador, Gestor de Frota e Financeiro -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding MostrarFinanceiro}">

                    <Frame Padding="16" CornerRadius="16" BorderColor="#DCE3EE" HasShadow="False" BackgroundColor="#F5F8FF">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Saldo atual (pago/recebido)" FontSize="12" TextColor="Gray" />
                            <Label Text="{Binding Saldo.SaldoAtualTexto}"
                                   TextColor="{Binding Saldo.CorSaldo}"
                                   FontSize="30"
                                   FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Frame>

                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="8" RowSpacing="8">
                        <Frame Grid.Row="0" Grid.Column="0" Padding="12" CornerRadius="12" BorderColor="#DCE3EE" HasShadow="False">
                            <VerticalStackLayout>
                                <Label Text="Entradas pagas" FontSize="11" TextColor="Gray" />
                                <Label Text="{Binding Saldo.EntradasPagasTexto}" TextColor="#1E8E3E" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Frame>
                        <Frame Grid.Row="0" Grid.Column="1" Padding="12" CornerRadius="12" BorderColor="#DCE3EE" HasShadow="False">
                            <VerticalStackLayout>
                                <Label Text="Saídas pagas" FontSize="11" TextColor="Gray" />
                                <Label Text="{Binding Saldo.SaidasPagasTexto}" TextColor="#D93025" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Frame>
                        <Frame Grid.Row="1" Grid.Column="0" Padding="12" CornerRadius="12" BorderColor="#DCE3EE" HasShadow="False">
                            <VerticalStackLayout>
                                <Label Text="A receber" FontSize="11" TextColor="Gray" />
                                <Label Text="{Binding Saldo.AReceberTexto}" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Frame>
                        <Frame Grid.Row="1" Grid.Column="1" Padding="12" CornerRadius="12" BorderColor="#DCE3EE" HasShadow="False">
                            <VerticalStackLayout>
                                <Label Text="A pagar" FontSize="11" TextColor="Gray" />
                                <Label Text="{Binding Saldo.APagarTexto}" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>

                    <Label Text="Projeção de caixa por mês de vencimento" FontAttributes="Bold" FontSize="16" />
                    <Label Text="Saldo atual somado aos lançamentos pendentes, mês a mês."
                           FontSize="12"
                           TextColor="Gray" />

                    <Label Text="Nenhum lançamento pendente para projetar."
                           TextColor="Gray"
                           IsVisible="{Binding SemProjecao}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Projecao}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ProjecaoMes">
                                <Frame Padding="12" CornerRadius="12" BorderColor="#DCE3EE" HasShadow="False">
                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                                        <Label Grid.Column="0"
                                               Text="{Binding MesTexto}"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1">
                                            <Label Text="{Binding EntradasTexto}" FontSize="12" TextColor="#1E8E3E" />
                                            <Label Text="{Binding SaidasTexto}" FontSize="12" TextColor="#D93025" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="End">
                                            <Label Text="Saldo projetado" FontSize="10" TextColor="Gray" HorizontalOptions="End" />
                                            <Label Text="{Binding SaldoProjetadoTexto}"
                                                   TextColor="{Binding CorSaldoProjetado}"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="End" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label Text="{Binding MensagemFinanceiro}"
                           TextColor="#D93025"
                           FontSize="13"
                           IsVisible="{Binding MensagemFinanceiro, Converter={StaticResource StringNotEmptyConverter}}" />
                </VerticalStackLayout>

                <!-- Motorista/Operador: sem módulos financeiros -->
                <Label Text="Seu perfil tem acesso restrito. Os módulos financeiros não ficam disponíveis para o Motorista."
                       FontSize="14"
                       TextColor="Gray"
                       HorizontalTextAlignment="Center"
                       IsVisible="{Binding MostrarFinanceiro, Converter={StaticResource InverseBoolConverter}}" />

                <Button Text="Sair"
                        Command="{Binding SairCommand}"
                        BackgroundColor="#0B1D3A"
                        TextColor="White"
                        CornerRadius="24"
                        HeightRequest="48"
                        WidthRequest="160"
                        HorizontalOptions="Center"
                        IsEnabled="{Binding Carregando, Converter={StaticResource InverseBoolConverter}}" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
