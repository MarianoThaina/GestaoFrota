<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GestaoFrota.App.ViewModels"
             xmlns:models="clr-namespace:GestaoFrota.App.Models"
             x:Class="GestaoFrota.App.Views.MovimentacaoFormPage"
             x:DataType="vm:MovimentacaoFormViewModel"
             Title="Nova movimentação">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="Tipo" FontSize="12" TextColor="Gray" />
            <Picker ItemsSource="{Binding Tipos}" SelectedItem="{Binding Tipo}" />

            <Label Text="Valor (R$)" FontSize="12" TextColor="Gray" />
            <Entry Placeholder="0,00"
                   Keyboard="Numeric"
                   Text="{Binding ValorTexto}" />

            <Label Text="Descrição" FontSize="12" TextColor="Gray" />
            <Entry Placeholder="Ex.: Abastecimento caminhão 01"
                   MaxLength="300"
                   Text="{Binding Descricao}" />

            <Label Text="Categoria" FontSize="12" TextColor="Gray" />
            <Picker Title="Escolha a categoria"
                    ItemsSource="{Binding Categorias}"
                    SelectedItem="{Binding CategoriaSelecionada}" />

            <Label Text="Forma de pagamento" FontSize="12" TextColor="Gray" />
            <Picker Title="Escolha a forma de pagamento"
                    ItemsSource="{Binding Formas}"
                    SelectedItem="{Binding FormaSelecionada}" />

            <Label Text="Data de vencimento" FontSize="12" TextColor="Gray" />
            <DatePicker Date="{Binding DataVencimento}" Format="dd/MM/yyyy" />

            <Grid ColumnDefinitions="*, Auto">
                <Label Grid.Column="0" Text="{Binding RotuloPago}" VerticalOptions="Center" FontAttributes="Bold" />
                <Switch Grid.Column="1" IsToggled="{Binding Pago}" />
            </Grid>

            <!-- A data de pagamento é obrigatória quando está pago/recebido -->
            <VerticalStackLayout IsVisible="{Binding Pago}" Spacing="4">
                <Label Text="Data do pagamento/recebimento" FontSize="12" TextColor="Gray" />
                <DatePicker Date="{Binding DataPagamento}"
                            MaximumDate="{Binding DataMaximaPagamento}"
                            Format="dd/MM/yyyy" />
            </VerticalStackLayout>

            <Label Text="Comprovante (opcional)" FontSize="12" TextColor="Gray" />
            <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                <Button Grid.Column="0"
                        Text="📷 Câmera"
                        Command="{Binding TirarFotoCommand}"
                        BackgroundColor="#2C6CE0"
                        TextColor="White" />
                <Button Grid.Column="1"
                        Text="🖼 Galeria"
                        Command="{Binding EscolherGaleriaCommand}"
                        BackgroundColor="#2C6CE0"
                        TextColor="White" />
            </Grid>

            <VerticalStackLayout IsVisible="{Binding TemComprovante}" Spacing="6">
                <Image Source="{Binding ComprovantePreview}"
                       HeightRequest="200"
                       Aspect="AspectFit" />
                <Button Text="Remover comprovante"
                        Command="{Binding RemoverComprovanteCommand}"
                        BackgroundColor="Gray"
                        TextColor="White" />
            </VerticalStackLayout>

            <Label Text="{Binding MensagemErro}"
                   TextColor="#D93025"
                   FontSize="13"
                   IsVisible="{Binding MensagemErro, Converter={StaticResource StringNotEmptyConverter}}" />

            <Button Text="Salvar movimentação"
                    Command="{Binding SalvarCommand}"
                    BackgroundColor="#0B1D3A"
                    TextColor="White"
                    CornerRadius="24"
                    HeightRequest="52"
                    IsEnabled="{Binding Carregando, Converter={StaticResource InverseBoolConverter}}" />

            <ActivityIndicator IsRunning="{Binding Carregando}" IsVisible="{Binding Carregando}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
