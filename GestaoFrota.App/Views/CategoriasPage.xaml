<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GestaoFrota.App.ViewModels"
             xmlns:models="clr-namespace:GestaoFrota.App.Models"
             x:Class="GestaoFrota.App.Views.CategoriasPage"
             x:DataType="vm:CategoriasViewModel"
             Title="Categorias">

    <Grid RowDefinitions="Auto, *" Padding="16" RowSpacing="12">

        <!-- Formulário de criação: só aparece para Administrador/Financeiro (RBAC) -->
        <Frame Grid.Row="0"
               IsVisible="{Binding PodeGerenciar}"
               Padding="12"
               CornerRadius="12"
               BorderColor="#DCE3EE">
            <VerticalStackLayout Spacing="8">
                <Entry Placeholder="Nome da categoria" Text="{Binding NovaCategoriaNome}" />
                <Picker Title="Tipo" SelectedItem="{Binding NovaCategoriaTipo}">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type models:TipoCategoria}">
                            <models:TipoCategoria>Receita</models:TipoCategoria>
                            <models:TipoCategoria>Despesa</models:TipoCategoria>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
                <Button Text="Adicionar categoria" Command="{Binding AdicionarCommand}" />
            </VerticalStackLayout>
        </Frame>

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding Carregando}"
                     Command="{Binding CarregarCommand}">
            <CollectionView ItemsSource="{Binding Categorias}">
                <CollectionView.EmptyView>
                    <Label Text="Nenhuma categoria cadastrada ainda."
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="Gray" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Categoria">
                        <Grid Padding="12,10" ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="{Binding Nome}" FontAttributes="Bold" />
                                <Label Text="{Binding Tipo}" FontSize="12" TextColor="Gray" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1"
                                   Text="Pendente"
                                   TextColor="Orange"
                                   FontSize="11"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding PendenteSincronizacao}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
