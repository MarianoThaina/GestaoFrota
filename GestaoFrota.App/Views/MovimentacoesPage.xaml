<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GestaoFrota.App.ViewModels"
             xmlns:models="clr-namespace:GestaoFrota.App.Models"
             x:Class="GestaoFrota.App.Views.MovimentacoesPage"
             x:DataType="vm:MovimentacoesViewModel"
             Title="Movimentações">

    <Grid RowDefinitions="Auto, Auto, Auto, *" Padding="16" RowSpacing="10">

        <!-- Novo lançamento: só Administrador/Financeiro (RBAC) -->
        <Button Grid.Row="0"
                Text="+ Nova movimentação"
                Command="{Binding NovaCommand}"
                IsVisible="{Binding PodeGerenciar}"
                BackgroundColor="#0B1D3A"
                TextColor="White"
                CornerRadius="24"
                HeightRequest="48" />

        <Grid Grid.Row="1" ColumnDefinitions="*, *" ColumnSpacing="8">
            <Picker Grid.Column="0"
                    Title="Tipo"
                    ItemsSource="{Binding OpcoesTipo}"
                    SelectedItem="{Binding FiltroTipo}" />
            <Picker Grid.Column="1"
                    Title="Situação"
                    ItemsSource="{Binding OpcoesStatus}"
                    SelectedItem="{Binding FiltroStatus}" />
        </Grid>

        <VerticalStackLayout Grid.Row="2" Spacing="2">
            <Label Text="{Binding ResumoLista}" FontSize="12" TextColor="Gray" />
            <Label Text="{Binding MensagemErro}"
                   TextColor="#D93025"
                   FontSize="13"
                   IsVisible="{Binding MensagemErro, Converter={StaticResource StringNotEmptyConverter}}" />
        </VerticalStackLayout>

        <RefreshView Grid.Row="3"
                     IsRefreshing="{Binding Carregando}"
                     Command="{Binding CarregarCommand}">
            <CollectionView ItemsSource="{Binding Itens}">
                <CollectionView.EmptyView>
                    <Label Text="Nenhuma movimentação encontrada."
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="Gray" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Movimentacao">
                        <Frame Padding="12" Margin="0,0,0,8" CornerRadius="12" BorderColor="#DCE3EE" HasShadow="False">
                            <VerticalStackLayout Spacing="6">

                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0"
                                           Text="{Binding Descricao}"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="1"
                                           Text="{Binding ValorFormatado}"
                                           TextColor="{Binding CorValor}"
                                           FontAttributes="Bold" />
                                </Grid>

                                <Label Text="{Binding DetalheTexto}" FontSize="12" TextColor="Gray" />

                                <Grid ColumnDefinitions="*, Auto">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding VencimentoTexto}" FontSize="12" TextColor="Gray" />
                                        <Label Text="{Binding PagamentoTexto}"
                                               FontSize="12"
                                               TextColor="Gray"
                                               IsVisible="{Binding TemPagamento}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1"
                                           Text="{Binding StatusTexto}"
                                           TextColor="{Binding CorStatus}"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           VerticalOptions="Center" />
                                </Grid>

                                <HorizontalStackLayout Spacing="8">
                                    <Button Text="Marcar como pago"
                                            FontSize="12"
                                            HeightRequest="36"
                                            Padding="12,0"
                                            BackgroundColor="#1E8E3E"
                                            TextColor="White"
                                            CornerRadius="18"
                                            IsVisible="{Binding PodePagar}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.PagarCommand}"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="Comprovante"
                                            FontSize="12"
                                            HeightRequest="36"
                                            Padding="12,0"
                                            BackgroundColor="#2C6CE0"
                                            TextColor="White"
                                            CornerRadius="18"
                                            IsVisible="{Binding TemComprovante}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.VerComprovanteCommand}"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="Estornar"
                                            FontSize="12"
                                            HeightRequest="36"
                                            Padding="12,0"
                                            BackgroundColor="#D9534F"
                                            TextColor="White"
                                            CornerRadius="18"
                                            IsVisible="{Binding PodeEstornar}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EstornarCommand}"
                                            CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>

                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
