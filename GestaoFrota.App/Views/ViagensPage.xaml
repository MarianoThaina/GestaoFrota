<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GestaoFrota.App.ViewModels"
             xmlns:models="clr-namespace:GestaoFrota.App.Models"
             x:Class="GestaoFrota.App.Views.ViagensPage"
             x:DataType="vm:ViagensViewModel"
             Title="Viagens">

    <Grid RowDefinitions="Auto, Auto, Auto, Auto, *" Padding="16" RowSpacing="10">

        <Button Grid.Row="0"
                Text="+ Abrir viagem"
                Command="{Binding AbrirCommand}"
                BackgroundColor="#0B1D3A"
                TextColor="White"
                CornerRadius="24"
                HeightRequest="48" />

        <!-- Sinal de que o app funciona sem internet (Offline-First, US08) -->
        <Frame Grid.Row="1"
               IsVisible="{Binding Offline}"
               Padding="12"
               CornerRadius="12"
               BorderColor="#F5D48A"
               BackgroundColor="#FFF8E1"
               HasShadow="False">
            <Label Text="{Binding AvisoOffline}" FontSize="12" TextColor="#7A5A00" />
        </Frame>

        <Picker Grid.Row="2"
                Title="Situação"
                ItemsSource="{Binding OpcoesFiltro}"
                SelectedItem="{Binding Filtro}" />

        <VerticalStackLayout Grid.Row="3" Spacing="2">
            <Label Text="{Binding ResumoLista}" FontSize="12" TextColor="Gray" />
            <Label Text="{Binding MensagemErro}"
                   TextColor="#D93025"
                   FontSize="13"
                   IsVisible="{Binding MensagemErro, Converter={StaticResource StringNotEmptyConverter}}" />
        </VerticalStackLayout>

        <RefreshView Grid.Row="4"
                     IsRefreshing="{Binding Carregando}"
                     Command="{Binding CarregarCommand}">
            <CollectionView ItemsSource="{Binding Itens}">
                <CollectionView.EmptyView>
                    <Label Text="Nenhuma viagem registrada ainda."
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="Gray" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Viagem">
                        <Frame Padding="12" Margin="0,0,0,8" CornerRadius="12" BorderColor="#DCE3EE" HasShadow="False">
                            <VerticalStackLayout Spacing="6">

                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0"
                                           Text="{Binding StatusTexto}"
                                           TextColor="{Binding CorStatus}"
                                           FontAttributes="Bold"
                                           FontSize="12" />
                                    <Label Grid.Column="1"
                                           Text="{Binding DataTexto}"
                                           FontSize="12"
                                           TextColor="Gray" />
                                </Grid>

                                <Label Text="{Binding TrajetoTexto}" FontAttributes="Bold" FontSize="16" />
                                <Label Text="{Binding VeiculoTexto}" FontSize="12" TextColor="Gray" />
                                <Label Text="{Binding MotoristaNome}" FontSize="12" TextColor="Gray" />

                                <!-- Hodômetros: inicial, final e rodado -->
                                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8" Margin="0,4,0,0">
                                    <Frame Grid.Column="0" Padding="8" CornerRadius="8" BorderColor="#DCE3EE" HasShadow="False" BackgroundColor="#F5F8FF">
                                        <VerticalStackLayout>
                                            <Label Text="Inicial" FontSize="10" TextColor="Gray" />
                                            <Label Text="{Binding HodometroInicialTexto}" FontAttributes="Bold" FontSize="13" />
                                        </VerticalStackLayout>
                                    </Frame>
                                    <Frame Grid.Column="1" Padding="8" CornerRadius="8" BorderColor="#DCE3EE" HasShadow="False" BackgroundColor="#F5F8FF">
                                        <VerticalStackLayout>
                                            <Label Text="Final" FontSize="10" TextColor="Gray" />
                                            <Label Text="{Binding HodometroFinalTexto}" FontAttributes="Bold" FontSize="13" />
                                        </VerticalStackLayout>
                                    </Frame>
                                    <Frame Grid.Column="2" Padding="8" CornerRadius="8" BorderColor="#0B1D3A" HasShadow="False" BackgroundColor="#0B1D3A">
                                        <VerticalStackLayout>
                                            <Label Text="Rodado" FontSize="10" TextColor="#9FB3D1" />
                                            <Label Text="{Binding RodadoTexto}" FontAttributes="Bold" FontSize="13" TextColor="White" />
                                        </VerticalStackLayout>
                                    </Frame>
                                </Grid>

                                <Label Text="{Binding ErroSincronizacao}"
                                       FontSize="12"
                                       TextColor="#D93025"
                                       IsVisible="{Binding TemErroSincronizacao}" />

                                <HorizontalStackLayout Spacing="8">
                                    <Button Text="Encerrar viagem"
                                            FontSize="12"
                                            HeightRequest="36"
                                            Padding="12,0"
                                            BackgroundColor="#1E8E3E"
                                            TextColor="White"
                                            CornerRadius="18"
                                            IsVisible="{Binding PodeEncerrar}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EncerrarCommand}"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="Cancelar"
                                            FontSize="12"
                                            HeightRequest="36"
                                            Padding="12,0"
                                            BackgroundColor="#D9534F"
                                            TextColor="White"
                                            CornerRadius="18"
                                            IsVisible="{Binding PodeCancelar}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CancelarCommand}"
                                            CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>

                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
