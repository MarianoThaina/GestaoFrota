<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GestaoFrota.App.ViewModels"
             xmlns:models="clr-namespace:GestaoFrota.App.Models"
             x:Class="GestaoFrota.App.Views.FormasPagamentoPage"
             x:DataType="vm:FormasPagamentoViewModel"
             Title="Formas de Pagamento">

    <Grid RowDefinitions="Auto, *" Padding="16" RowSpacing="12">

        <Frame Grid.Row="0"
               IsVisible="{Binding PodeGerenciar}"
               Padding="12"
               CornerRadius="12"
               BorderColor="#DCE3EE">
            <VerticalStackLayout Spacing="8">
                <Entry Placeholder="Nome da forma de pagamento" Text="{Binding NovaFormaNome}" />
                <Button Text="Adicionar forma de pagamento" Command="{Binding AdicionarCommand}" />
            </VerticalStackLayout>
        </Frame>

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding Carregando}"
                     Command="{Binding CarregarCommand}">
            <CollectionView ItemsSource="{Binding Formas}">
                <CollectionView.EmptyView>
                    <Label Text="Nenhuma forma de pagamento cadastrada ainda."
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="Gray" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:FormaPagamento">
                        <Grid Padding="12,10" ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="{Binding Nome}" FontAttributes="Bold" />
                            <Label Grid.Column="1"
                                   Text="Pendente"
                                   TextColor="Orange"
                                   FontSize="11"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding PendenteSincronizacao}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
