<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GestaoFrota.App.ViewModels"
             x:Class="GestaoFrota.App.Views.ComprovantePage"
             x:DataType="vm:ComprovanteViewModel"
             Title="Comprovante">

    <Grid Padding="16">
        <ActivityIndicator IsRunning="{Binding Carregando}"
                           IsVisible="{Binding Carregando}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />

        <Image Source="{Binding Imagem}" Aspect="AspectFit" />

        <Label Text="{Binding MensagemErro}"
               TextColor="#D93025"
               VerticalOptions="Center"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               IsVisible="{Binding MensagemErro, Converter={StaticResource StringNotEmptyConverter}}" />
    </Grid>

</ContentPage>
