<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GestaoFrota.App.ViewModels"
             xmlns:models="clr-namespace:GestaoFrota.App.Models"
             x:Class="GestaoFrota.App.Views.UsuariosPage"
             x:DataType="vm:UsuariosViewModel"
             Title="Usuários">

    <Grid Padding="16" RowDefinitions="Auto, Auto, Auto, *" RowSpacing="12">

        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="Gestão de Usuários" FontSize="24" FontAttributes="Bold" />
            <Label Text="Aprove cadastros novos, defina perfis e controle quem pode entrar."
                   FontSize="13"
                   TextColor="Gray" />
        </VerticalStackLayout>

        <!-- US16: cadastros aguardando aprovação -->
        <Frame Grid.Row="1"
               IsVisible="{Binding AvisoPendentes, Converter={StaticResource StringNotEmptyConverter}}"
               Padding="12"
               CornerRadius="12"
               BorderColor="#F5D48A"
               BackgroundColor="#FFF8E1"
               HasShadow="False">
            <Label Text="{Binding AvisoPendentes}" FontSize="12" TextColor="#7A5A00" />
        </Frame>

        <Label Grid.Row="2"
               Text="{Binding MensagemErro}"
               TextColor="#D93025"
               FontSize="13"
               IsVisible="{Binding MensagemErro, Converter={StaticResource StringNotEmptyConverter}}" />

        <RefreshView Grid.Row="3"
                     IsRefreshing="{Binding Carregando}"
                     Command="{Binding CarregarCommand}">
            <CollectionView ItemsSource="{Binding Usuarios}">
                <CollectionView.EmptyView>
                    <Label Text="Nenhum usuário encontrado."
                           TextColor="Gray"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Usuario">
                        <Frame Padding="14" Margin="0,5" CornerRadius="12" BorderColor="#DCE3EE" HasShadow="False">
                            <VerticalStackLayout Spacing="10">

                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding Nome}" FontSize="18" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Email}" FontSize="13" TextColor="Gray" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1"
                                           Text="{Binding SituacaoTexto}"
                                           TextColor="{Binding CorSituacao}"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           VerticalOptions="Start" />
                                </Grid>

                                <Label Text="Perfil" FontAttributes="Bold" FontSize="13" />
                                <Picker Title="Selecione o perfil"
                                        ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type vm:UsuariosViewModel}}, Path=PerfisDisponiveis}"
                                        SelectedItem="{Binding Perfil}" />

                                <!-- Pendente: aprovar com o perfil escolhido acima -->
                                <Button Text="Aprovar cadastro"
                                        BackgroundColor="#1E8E3E"
                                        TextColor="White"
                                        CornerRadius="20"
                                        IsVisible="{Binding AguardandoAprovacao}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:UsuariosViewModel}}, Path=AprovarCommand}"
                                        CommandParameter="{Binding .}" />

                                <!-- Já liberado: salvar perfil e ativar/desativar -->
                                <Grid ColumnDefinitions="*, *" ColumnSpacing="8"
                                      IsVisible="{Binding AguardandoAprovacao, Converter={StaticResource InverseBoolConverter}}">
                                    <Button Grid.Column="0"
                                            Text="Salvar perfil"
                                            BackgroundColor="#2C6CE0"
                                            TextColor="White"
                                            CornerRadius="20"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:UsuariosViewModel}}, Path=SalvarPerfilCommand}"
                                            CommandParameter="{Binding .}" />
                                    <Button Grid.Column="1"
                                            Text="{Binding BotaoSituacaoTexto}"
                                            BackgroundColor="#5F6B7A"
                                            TextColor="White"
                                            CornerRadius="20"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:UsuariosViewModel}}, Path=AlterarSituacaoCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>

                                <Label Text="{Binding CadastroTexto}" FontSize="11" TextColor="Gray" />
                                <Label Text="{Binding UltimoLogin, StringFormat='Último login: {0:dd/MM/yyyy HH:mm}'}"
                                       FontSize="11"
                                       TextColor="Gray" />

                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
