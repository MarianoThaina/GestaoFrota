<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:GestaoFrota.App.ViewModels"
    xmlns:models="clr-namespace:GestaoFrota.App.Models"
    x:Class="GestaoFrota.App.Views.UsuariosPage"
    x:DataType="vm:UsuariosViewModel"
    Title="Usuários">

    <Grid
        Padding="16"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="12">

        <VerticalStackLayout
            Grid.Row="0"
            Spacing="4">

            <Label
                Text="Gestão de Usuários"
                FontSize="24"
                FontAttributes="Bold" />

            <Label
                Text="Gerencie os perfis e acessos dos usuários do sistema."
                FontSize="13"
                TextColor="#5F6368" />

        </VerticalStackLayout>

        <!-- Novo usuário com e-mail e senha: a conta já nasce com o perfil escolhido. -->
        <VerticalStackLayout
            Grid.Row="1"
            Spacing="10"
            IsVisible="{Binding PodeGerenciar}">

            <Button
                Text="+ Novo usuário"
                Command="{Binding AlternarNovoUsuarioCommand}"
                BackgroundColor="#0B2545"
                TextColor="White"
                CornerRadius="24"
                HeightRequest="48" />

            <Frame
                Padding="14"
                CornerRadius="12"
                BorderColor="#D3E5E1"
                HasShadow="False"
                IsVisible="{Binding MostrarNovoUsuario}">

                <VerticalStackLayout Spacing="8">

                    <Label Text="Novo usuário" FontSize="16" FontAttributes="Bold" />

                    <Entry Placeholder="Nome" Text="{Binding NovoNome}" />

                    <Entry Placeholder="E-mail" Text="{Binding NovoEmail}" Keyboard="Email"
                           IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />

                    <Picker
                        Title="Perfil"
                        ItemsSource="{x:Static vm:UsuariosViewModel.Perfis}"
                        ItemDisplayBinding="{Binding ., Converter={StaticResource PerfilNomeConverter}}"
                        SelectedItem="{Binding NovoPerfil}" />

                    <Entry Placeholder="Senha inicial" Text="{Binding NovaSenha}" IsPassword="True" />

                    <Label
                        Text="Pelo menos 8 caracteres, com letras e números. Passe a senha à pessoa por um canal seguro."
                        FontSize="12"
                        TextColor="#5F6368" />

                    <Label
                        Text="{Binding ErroNovoUsuario}"
                        TextColor="#C5221F"
                        FontSize="13"
                        IsVisible="{Binding ErroNovoUsuario, Converter={StaticResource StringNotEmptyConverter}}" />

                    <Button
                        Text="Criar usuário"
                        Command="{Binding CriarUsuarioCommand}"
                        HeightRequest="48" />

                </VerticalStackLayout>

            </Frame>

        </VerticalStackLayout>

        <Label
            Grid.Row="2"
            Text="{Binding MensagemErro}"
            TextColor="Red"
            FontSize="13" />

        <RefreshView
            Grid.Row="3"
            IsRefreshing="{Binding Carregando}"
            Command="{Binding CarregarCommand}">

            <CollectionView
                ItemsSource="{Binding Usuarios}">

                <CollectionView.EmptyView>

                    <VerticalStackLayout
                        Padding="20"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                        <Label
                            Text="Nenhum usuário encontrado."
                            TextColor="#5F6368"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>

                    <DataTemplate x:DataType="models:Usuario">

                        <Frame
                            Padding="14"
                            Margin="0,5"
                            CornerRadius="12"
                            BorderColor="#D3E5E1">

                            <VerticalStackLayout
                                Spacing="10">

                                <Label
                                    Text="{Binding Nome}"
                                    FontSize="18"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="{Binding Email}"
                                    FontSize="13"
                                    TextColor="#5F6368" />

                                <HorizontalStackLayout
                                    Spacing="5">

                                    <Label
                                        Text="Status:"
                                        FontAttributes="Bold" />

                                    <Label>
                                        <Label.Triggers>

                                            <DataTrigger
                                                TargetType="Label"
                                                Binding="{Binding Ativo}"
                                                Value="True">

                                                <Setter
                                                    Property="Text"
                                                    Value="Ativo" />

                                                <Setter
                                                    Property="TextColor"
                                                    Value="Green" />

                                            </DataTrigger>

                                            <DataTrigger
                                                TargetType="Label"
                                                Binding="{Binding Ativo}"
                                                Value="False">

                                                <Setter
                                                    Property="Text"
                                                    Value="Inativo" />

                                                <Setter
                                                    Property="TextColor"
                                                    Value="Red" />

                                            </DataTrigger>

                                        </Label.Triggers>
                                    </Label>

                                </HorizontalStackLayout>

                                <Label
                                    Text="Perfil do usuário"
                                    FontAttributes="Bold"
                                    FontSize="13" />

                                <Picker
                                    Title="Selecione o perfil"
                                    ItemsSource="{x:Static vm:UsuariosViewModel.Perfis}"
                                    ItemDisplayBinding="{Binding ., Converter={StaticResource PerfilNomeConverter}}"
                                    SelectedItem="{Binding Perfil}" />

                                <Button
                                    Text="Salvar perfil"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:UsuariosViewModel}}, Path=SalvarPerfilCommand}"
                                    CommandParameter="{Binding .}" />

                                <Button
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:UsuariosViewModel}}, Path=AlterarStatusCommand}"
                                    CommandParameter="{Binding .}">

                                    <Button.Triggers>

                                        <DataTrigger
                                            TargetType="Button"
                                            Binding="{Binding Ativo}"
                                            Value="True">

                                            <Setter
                                                Property="Text"
                                                Value="Desativar usuário" />

                                        </DataTrigger>

                                        <DataTrigger
                                            TargetType="Button"
                                            Binding="{Binding Ativo}"
                                            Value="False">

                                            <Setter
                                                Property="Text"
                                                Value="Ativar usuário" />

                                        </DataTrigger>

                                    </Button.Triggers>

                                </Button>

                                <Button
                                    Text="Definir senha"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:UsuariosViewModel}}, Path=DefinirSenhaCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="Transparent"
                                    BorderColor="#0B2545"
                                    BorderWidth="1"
                                    TextColor="#0B2545" />

                                <Label
                                    Text="{Binding FormasDeEntrar}"
                                    FontSize="12"
                                    TextColor="#5F6368" />

                                <Label
                                    Text="{Binding UltimoLogin, StringFormat='Último login: {0:dd/MM/yyyy HH:mm}'}"
                                    FontSize="11"
                                    TextColor="#5F6368" />

                            </VerticalStackLayout>

                        </Frame>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </RefreshView>

    </Grid>

</ContentPage>
